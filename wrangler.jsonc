{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pofu",
  // Wraps the OpenNext build output and adds the Cron Trigger handler.
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pofu",
      // Replace with the id printed by `npx wrangler d1 create pofu`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Every 5 minutes: send due engagements. Hourly at :07: full readiness re-evaluation.
    "crons": ["*/5 * * * *", "7 * * * *"]
  },
  "observability": { "enabled": true }
}
