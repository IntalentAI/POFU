{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pofu",
  // Wraps the OpenNext build output and adds the Cron Trigger handler.
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Variables are managed in the Cloudflare dashboard; don't wipe them on deploy.
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pofu",
      // Primary location: eastern North America (created with location hint "enam").
      "database_id": "23f8e849-ba3d-4fa1-bd13-dc391c646022",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Every 5 minutes: send due engagements. Hourly at :07: full readiness re-evaluation.
    "crons": ["*/5 * * * *", "7 * * * *"]
  },
  "observability": { "enabled": true }
}
