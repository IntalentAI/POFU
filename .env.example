DATABASE_URL="file:./dev.db"
AUTH_SECRET="dev-only-change-me-please-32-chars-min"
APP_URL="http://localhost:3000"
# Runs the follow-up scheduler inside the Next.js server every minute (dev / single-instance hosting).
ENABLE_INTERNAL_SCHEDULER="true"
CRON_SECRET="dev-cron-secret"
# Optional: enables the Claude-powered companion. Without it a rules-based fallback is used.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5-5"
# Optional channels — without these, outbound messages are recorded as "simulated".
# SMTP_URL="smtps://user:pass@smtp.example.com:465"
# EMAIL_FROM="Acme Joining Team <joining@example.com>"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# TWILIO_SMS_FROM="+15555550100"
# WHATSAPP_CLOUD_TOKEN=""
# WHATSAPP_CLOUD_PHONE_ID=""
# WHATSAPP_VERIFY_TOKEN=""

# Production container only (set by the Cloud Run deploy workflow)
# LITESTREAM_REPLICA_URL="gcs://your-bucket/app.db"
# SEED_DEMO="true"
